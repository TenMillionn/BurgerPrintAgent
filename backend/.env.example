# ─── App ───────────────────────────────────────────────
PORT=3000

# ─── Redis (password-protected; bound to 127.0.0.1 only) ───
# REDIS_PASSWORD is required by docker-compose and must appear in REDIS_URL.
REDIS_PASSWORD=change-me-redis-password
# Local (node host): redis://:${REDIS_PASSWORD}@localhost:6379
# Docker app: overridden in docker-compose to redis://:${REDIS_PASSWORD}@redis:6379
REDIS_URL=redis://:change-me-redis-password@localhost:6379

# ─── MongoDB (auth enabled; bound to 127.0.0.1 only) ───────
# MONGO_USER/MONGO_PASSWORD are required by docker-compose (root user) and must
# appear in MONGODB_URI with ?authSource=admin.
MONGO_USER=bpadmin
MONGO_PASSWORD=change-me-mongo-password
# Local (node host): mongodb://${MONGO_USER}:${MONGO_PASSWORD}@localhost:27017/burgerprints?authSource=admin
# Docker app: overridden in docker-compose to use the mongo service host.
MONGODB_URI=mongodb://bpadmin:change-me-mongo-password@localhost:27017/burgerprints?authSource=admin

# ─── Auth / JWT ────────────────────────────────────────
JWT_SECRET=super-secret-key-change-me-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Auth / Google OAuth (Optional) ────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
# Where the backend redirects after Google login (your frontend origin)
FRONTEND_URL=http://localhost:5173

# ─── Session ───────────────────────────────────────────
SESSION_TTL_SECONDS=3600
MAX_CONTEXT_TURNS=30

# ─── LLM (provider-agnostic, qua @earendil-works/pi-ai) ─
# LLM_PROVIDER = anthropic | openai
LLM_PROVIDER=anthropic
# Model id (pi-ai). Để trống → default: anthropic=claude-sonnet-4-5, openai=gpt-4o
LLM_MODEL=
# Bắt buộc nếu LLM_PROVIDER=anthropic (pi-ai đọc trực tiếp từ env này)
ANTHROPIC_API_KEY=
# Bắt buộc nếu LLM_PROVIDER=openai
OPENAI_API_KEY=
# (Tùy chọn) override endpoint OpenAI-compatible: proxy / Azure / OpenRouter / local
# vd https://openrouter.ai/api/v1 — để trống → dùng endpoint OpenAI mặc định
OPENAI_BASE_URL=

# ─── BurgerPrints API v2.0 ─────────────────────────────
BURGERPRINTS_API_BASE_URL=https://api.burgerprints.com/v2
# Lấy key: Fulfillment store → Settings → API Keys (BTC cấp)
BURGERPRINTS_API_KEY=
CATALOG_CACHE_TTL_SECONDS=300

# ─── Cloudflare R2 (design/mockup image hosting, S3-compatible) ───
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=burgerprint
# S3 API endpoint: https://<account>.r2.cloudflarestorage.com
R2_ENDPOINT=
# Public bucket base, e.g. https://pub-<hash>.r2.dev
R2_PUBLIC_BASE_URL=
# Max upload size in bytes (default 10 MB)
UPLOAD_MAX_BYTES=10485760

# ─── Seller API-key encryption (AES-256-GCM) ───
# Long random secret. Rotating it invalidates all stored seller BurgerPrints keys.
ENCRYPTION_KEY=
