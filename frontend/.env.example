# Backend base URL baked into the build (Vite exposes VITE_* to the client).
# Required for the Chrome extension build, which runs on a chrome-extension://
# origin and must call the backend by absolute URL (no relative '/api' proxy).
#
# Leave unset for local dev:
#   - web (vite dev) uses the '/api' proxy from vite.config.js
#   - extension falls back to http://localhost:3001
#
# CI sets this for released extension builds (see .github/workflows/release-extension.yml).
VITE_BACKEND_URL=https://burgerprint.vocatee.com/api
